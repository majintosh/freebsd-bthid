+	int		intr_sock;
+	uint16_t	vendor_id;
+	uint16_t	product_id;
+	uint16_t	version_id;
+	void		*rdesc;
+	size_t		rdesc_len;
+
+};
+
+#define BTHIDBUS_NEW_CONNECTION _IOW('B', 1, struct bthidbus_new_connection)
+
+#endif /* !_BTHIDBUS_H_ */
